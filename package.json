{
  "name": "dsh-opencode-model-sync",
  "version": "0.1.0",
  "description": "Keep the DSH model picker in sync with the live OpenCode Go model catalog — new models appear without a DSH release.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "opencode",
    "opencode-go",
    "model-catalog"
  ],
  "license": "MIT",
  "author": "dsh-opencode-model-sync contributors",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check lib/catalog.js && node --check lib/config.js && node --check lib/engine.js && node --check lib/tool.js",
    "pack": "npm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "node": ">=20.3"
  }
}
